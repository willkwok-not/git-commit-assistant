{
  "name": "ai-git-commit",
  "displayName": "AI Git Commit",
  "description": "根据 Git 暂存区变更调用 AI 自动生成提交消息。",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiGitCommit.generate",
        "title": "AI Git Commit: 生成提交消息",
        "icon": "$(sparkle)"
      },
      {
        "command": "aiGitCommit.cancel",
        "title": "AI Git Commit: 取消生成",
        "icon": "$(debug-stop)"
      },
      {
        "command": "aiGitCommit.setApiKey",
        "title": "AI Git Commit: 设置 API Key"
      },
      {
        "command": "aiGitCommit.clearApiKey",
        "title": "AI Git Commit: 清除 API Key"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aiGitCommit.generate",
          "when": "scmProvider == git && !aiGitCommit.generating",
          "group": "navigation"
        },
        {
          "command": "aiGitCommit.cancel",
          "when": "scmProvider == git && aiGitCommit.generating",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "AI Git Commit",
      "properties": {
        "aiGitCommit.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "order": 1,
          "description": "OpenAI 兼容接口的基础地址，或完整的 /chat/completions 地址。"
        },
        "aiGitCommit.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "order": 2,
          "description": "用于生成提交消息的模型名称。"
        },
        "aiGitCommit.requireApiKey": {
          "type": "boolean",
          "default": true,
          "order": 3,
          "description": "是否要求 API Key。使用 Ollama 等本地无鉴权服务时可关闭。"
        },
        "aiGitCommit.language": {
          "type": "string",
          "enum": [
            "简体中文",
            "English",
            "日本語"
          ],
          "default": "简体中文",
          "order": 4,
          "description": "提交消息使用的语言。"
        },
        "aiGitCommit.useConventionalCommits": {
          "type": "boolean",
          "default": true,
          "order": 5,
          "description": "要求生成 Conventional Commits 格式的消息。"
        },
        "aiGitCommit.customInstructions": {
          "type": "string",
          "default": "",
          "order": 6,
          "markdownDescription": "附加给模型的提交消息规则，例如：`主题不超过 50 个字符`。"
        },
        "aiGitCommit.maxDiffCharacters": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 200000,
          "order": 7,
          "description": "发送给模型的暂存区 diff 最大字符数。超出部分会被截断。"
        },
        "aiGitCommit.requestTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 300,
          "order": 8,
          "description": "模型请求超时时间（秒）。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/prompt.test.js out/test/client.test.js",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
