{
  "name": "ai-git-commit",
  "displayName": "AI Git Commit",
  "icon": "images/icon.png",
  "description": "%extension.description%",
  "version": "0.2.0",
  "publisher": "willkwok",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/willkwok-not/ai-git-commit.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "aiGitCommit.generate",
        "title": "%command.generate.title%",
        "icon": "$(sparkle)"
      },
      {
        "command": "aiGitCommit.cancel",
        "title": "%command.cancel.title%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "aiGitCommit.setApiKey",
        "title": "%command.setApiKey.title%"
      },
      {
        "command": "aiGitCommit.clearApiKey",
        "title": "%command.clearApiKey.title%"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "aiGitCommit.generate",
          "when": "scmProvider == git && !aiGitCommit.generating",
          "group": "navigation"
        },
        {
          "command": "aiGitCommit.cancel",
          "when": "scmProvider == git && aiGitCommit.generating",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "AI Git Commit",
      "properties": {
        "aiGitCommit.baseUrl": {
          "type": "string",
          "order": 1,
          "description": "%configuration.baseUrl.description%"
        },
        "aiGitCommit.model": {
          "type": "string",
          "order": 2,
          "description": "%configuration.model.description%"
        },
        "aiGitCommit.requireApiKey": {
          "type": "boolean",
          "default": true,
          "order": 3,
          "description": "%configuration.requireApiKey.description%"
        },
        "aiGitCommit.language": {
          "type": "string",
          "enum": [
            "简体中文",
            "繁體中文",
            "English",
            "日本語",
            "한국어",
            "Français",
            "Deutsch",
            "Español",
            "Português",
            "Italiano",
            "Русский"
          ],
          "default": "English",
          "order": 4,
          "description": "%configuration.language.description%"
        },
        "aiGitCommit.useConventionalCommits": {
          "type": "boolean",
          "default": true,
          "order": 5,
          "description": "%configuration.useConventionalCommits.description%"
        },
        "aiGitCommit.customInstructions": {
          "type": "string",
          "default": "",
          "order": 6,
          "markdownDescription": "%configuration.customInstructions.description%"
        },
        "aiGitCommit.maxDiffCharacters": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 200000,
          "order": 7,
          "description": "%configuration.maxDiffCharacters.description%"
        },
        "aiGitCommit.requestTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 300,
          "order": 8,
          "description": "%configuration.requestTimeoutSeconds.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/prompt.test.js out/test/client.test.js out/test/localization.test.js",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
