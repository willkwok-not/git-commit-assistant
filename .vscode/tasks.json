{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "pnpm: compile",
      "command": "pnpm run compile",
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "type": "shell",
      "label": "pnpm: watch",
      "command": "pnpm run watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": "build"
    }
  ]
}
